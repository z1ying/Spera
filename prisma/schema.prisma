// ImpactLink data model — implements design doc §4 exactly
// (~/workspace/hackathon-prep/hsi-tpw-design-doc.md).
// Privacy (§4.1): there are deliberately NO name / date-of-birth / case-number
// fields anywhere in this schema. Participants exist only as hashed
// pseudonymous keys (see src/lib/privacy.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String      @id
  name         String
  /// JSON array of program type labels, as supplied by the org.
  programTypes String      @map("program_types")
  /// JSON array of facility names.
  facilities   String
  /// A = outcomes linked, B = process data only, C = critical fields missing (§6.1).
  dataGrade    String      @map("data_grade")
  programs     Program[]
  importJobs   ImportJob[]
  aliases      ProgramAlias[]

  @@map("organizations")
}

model Program {
  id           String       @id
  orgId        String       @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id])
  name         String
  /// education | vocational | sud | restorative | reentry | other (§4)
  type         String
  facility     String
  startDate    DateTime     @map("start_date")
  endDate      DateTime     @map("end_date")
  enrollments  Enrollment[]
  aliases      ProgramAlias[]

  @@map("programs")
}

model Participant {
  /// SHA-256 hashed pseudonymous key (§4.1). Never a raw identity.
  participantKey String       @id @map("participant_key")
  releaseYear    Int          @map("release_year")
  ageBand        String       @map("age_band")
  gender         String
  riskBand       String       @map("risk_band")
  enrollments    Enrollment[]
  outcomes       Outcome[]

  @@map("participants")
}

model Enrollment {
  id             String      @id
  participantKey String      @map("participant_key")
  participant    Participant @relation(fields: [participantKey], references: [participantKey])
  programId      String      @map("program_id")
  program        Program     @relation(fields: [programId], references: [id])
  enrollDate     DateTime    @map("enroll_date")
  /// enrolled | completed | dropped
  status         String
  completionDate DateTime?   @map("completion_date")
  /// JSON: {"<credit code>": boolean}, codes from the framework file (TPW: MCC, RACC, EMC)
  credits        String

  @@map("enrollments")
}

model Outcome {
  id             String      @id
  participantKey String      @map("participant_key")
  participant    Participant @relation(fields: [participantKey], references: [participantKey])
  /// arrest | conviction | return_to_custody | parole_violation | parole_discharge
  /// (the framework file chooses which are tracked; src/lib/framework.ts)
  eventType      String      @map("event_type")
  eventDate      DateTime    @map("event_date")
  /// felony | misdemeanor; null for events that are not offenses (parole_discharge)
  offenseLevel   String?     @map("offense_level")

  @@map("outcomes")
}

model CostParam {
  key    String @id
  value  Float
  source String
  year   Int

  @@map("cost_params")
}

/// An organization's own name for one of its programs (§6.1 step 4: program
/// names are normalized through a per-org dictionary; unmatched names go to a
/// manual classification queue and the answer is saved here as the template).
model ProgramAlias {
  orgId        String       @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id])
  label        String
  programId    String       @map("program_id")
  program      Program      @relation(fields: [programId], references: [id])

  @@id([orgId, label])
  @@map("program_aliases")
}

model ImportJob {
  id           String        @id
  /// Null when one file spans several organizations, or for an outcome file
  /// from an external system (orgs touched are recorded in `mapping`).
  orgId        String?       @map("org_id")
  organization Organization? @relation(fields: [orgId], references: [id])
  /// enrollments | outcomes
  kind         String        @default("enrollments")
  fileName     String       @map("file_name")
  status       String
  /// JSON: confirmed column mapping (§6.1). Null until confirmed.
  mapping      String?
  /// JSON: array of validation issues. Never silently dropped (§6.1).
  issues       String?
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("import_jobs")
}

// ---------------------------------------------------------------------------
// Program-run reporting (design doc §28): what TPW actually collects today.
// One row per program run (cohort) — aggregate counts only, no individuals,
// no identifiers. These tables back the organization form and TPW dashboard.
// ---------------------------------------------------------------------------

/// A TPW member organization (real names, as organizations report them).
model PartnerOrg {
  id        String           @id
  name      String           @unique
  createdAt DateTime         @default(now()) @map("created_at")
  programs  PartnerProgram[]
  runs      ProgramRun[]

  @@map("partner_orgs")
}

model PartnerProgram {
  id    String       @id
  orgId String       @map("org_id")
  org   PartnerOrg   @relation(fields: [orgId], references: [id])
  name  String
  runs  ProgramRun[]

  @@unique([orgId, name])
  @@map("partner_programs")
}

/// CDCR institution, with flags from published sources (scripts/convert_tpw_xlsx.py).
model Facility {
  code         String       @id
  name         String
  /// Target ("underserved") institution in CDCR RIGHT Grant 3.0, Attachment A.
  right3Target Boolean      @map("right3_target")
  womens       Boolean
  runs         ProgramRun[]

  @@map("facilities")
}

model ProgramRun {
  id                 String         @id
  orgId              String         @map("org_id")
  org                PartnerOrg     @relation(fields: [orgId], references: [id])
  programId          String         @map("program_id")
  program            PartnerProgram @relation(fields: [programId], references: [id])
  facilityCode       String         @map("facility_code")
  facility           Facility       @relation(fields: [facilityCode], references: [code])
  yard               String?
  /// Planned | In Progress | Completed
  status             String
  startDate          DateTime?      @map("start_date")
  endDate            DateTime?      @map("end_date")
  /// Total programming hours per participant ("Total Programming hours").
  totalHours         Float?         @map("total_hours")
  participants       Int?
  completed          Int?
  /// Serves RHU / EOP / MHCB (RIGHT 3.0 target populations).
  specialPopulations Boolean        @default(false) @map("special_populations")
  notes              String?
  /// "form" (submitted on ImpactLink) or "import:<file>#<row>".
  source             String
  /// Secret returned to the submitting browser; required to edit a form run
  /// (organizations don't log in — design doc §28). Null for imported rows.
  editToken          String?        @map("edit_token")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@map("program_runs")
}
