# Copy to .env for local development. Never commit a real .env.

# SQLite database file, relative to prisma/schema.prisma (design doc §2).
DATABASE_URL="file:../data/impactlink.db"

# Demo mode (design doc §2/§6.2): "1" = import wizard replays cached LLM
# mapping results so the demo runs fully offline. Leave unset for live mode.
DEMO_MODE=

# Gemini API key for the import wizard's field-mapping suggestions (§6).
# Sponsor credits are issued at the venue. Without a key the wizard falls
# back to rule-based mapping + manual confirmation.
GEMINI_API_KEY=
