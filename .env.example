# Copy to .env for local development. Never commit a real .env.

# SQLite database file, relative to prisma/schema.prisma.
DATABASE_URL="file:../data/impactlink.db"

# Passcode TPW staff use to open the dashboard. Leave empty = nobody can sign in.
TPW_PASSCODE=

# Writing assistant on /grants: Gemma via the Gemini API (key from Google AI Studio).
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
